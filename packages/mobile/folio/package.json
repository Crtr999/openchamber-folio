{
  "name": "@openchamber/folio-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone iPhone Folio. Reuses packages/mobile's installed Capacitor packages.",
  "scripts": {
    "prepare:assets": "node scripts/prepare-web-assets.mjs",
    "sync": "node scripts/prepare-web-assets.mjs && ../node_modules/.bin/cap sync ios"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  }
}
