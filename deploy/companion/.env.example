# Copy to a private file OUTSIDE the checkout. Never publish it.
CARTER_HOSTNAME=carter.example.com
ACME_EMAIL=you@example.com
OPENCHAMBER_UI_PASSWORD=replace-with-a-long-unique-password
TZ=America/New_York

# Optional personal native push, only with native-push.compose.yaml.
# IDs are public configuration; the .p8 PRIVATE KEY stays in a separate file.
# CARTER_APNS_KEY_ID=YOURKEYID1
# CARTER_APNS_TEAM_ID=YOURTEAM01
# CARTER_IOS_BUNDLE_ID=com.yourname.opencarter
# CARTER_APNS_KEY_FILE=/private/path/on/server/AuthKey.p8
